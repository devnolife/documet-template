{
  "name": "generate-document-api",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:watch": "node --watch server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:unit": "jest tests/unit --detectOpenHandles --forceExit",
    "test:integration": "jest tests/integration --detectOpenHandles --forceExit",
    "test:e2e": "jest tests/e2e --detectOpenHandles --forceExit",
    "test:watch": "jest --watch --detectOpenHandles",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,json,md}\"",
    "seed": "node ./src/infrastructure/database/prisma/seeds/index.js",
    "seed:eddsa": "node ./src/infrastructure/database/prisma/seeds/eddsa-system.seed.js",
    "prisma:generate": "prisma generate --schema=./src/infrastructure/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./src/infrastructure/database/prisma/schema.prisma",
    "prisma:migrate:prod": "prisma migrate deploy --schema=./src/infrastructure/database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./src/infrastructure/database/prisma/schema.prisma",
    "prisma:reset": "prisma migrate reset --schema=./src/infrastructure/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema=./src/infrastructure/database/prisma/schema.prisma",
    "db:seed": "npm run seed",
    "clean": "rm -rf node_modules coverage logs",
    "clean:storage": "rm -rf storage/outputs/* storage/qrcodes/* storage/uploads/*"
  },
  "prisma": {
    "schema": "src/infrastructure/database/prisma/schema.prisma",
    "seed": "node src/infrastructure/database/prisma/seeds/index.js"
  },
  "author": "devnolife",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "axios": "^1.12.1",
    "cors": "^2.8.5",
    "docxtemplater": "^3.53.0",
    "docxtemplater-image-module-free": "^1.1.1",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.1",
    "form-data": "^4.0.1",
    "fs-extra": "^11.2.0",
    "helmet": "^8.1.0",
    "jimp": "^1.6.0",
    "moment": "^2.30.1",
    "moment-hijri": "^3.0.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "pizzip": "^3.1.7",
    "qrcode": "^1.5.4",
    "uuid": "^10.0.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4"
  }
}
